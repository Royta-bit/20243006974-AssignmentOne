<?xml version="1.0" encoding="utf-8"?>
<!--
    Landscape main screen: the banner still runs across the top, but the four
    service areas now sit side by side in a single row. This file is the
    portrait layout with the grid switched from two columns to four.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Banner photograph with the application title centred over it. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/banner_title"
            android:scaleType="centerCrop"
            android:src="@drawable/img_main_banner" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:shadowColor="@color/black"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="@dimen/screen_padding"
            android:text="@string/banner_title"
            android:textColor="@color/white"
            android:textSize="@dimen/banner_title_text_size"
            android:textStyle="bold" />
    </FrameLayout>

    <!--
        Four service areas. Each cell holds a button carrying the white icon on
        a green background, with the area name beneath it.
    -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:columnCount="4"
        android:padding="@dimen/screen_padding"
        android:rowCount="1">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <ImageButton
                android:id="@+id/button_facilities"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/button_selector"
                android:contentDescription="@string/facilities"
                android:padding="@dimen/tile_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_facilities"
                app:backgroundTint="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/facilities"
                android:textColor="@color/black"
                android:textSize="@dimen/tile_label_text_size" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <ImageButton
                android:id="@+id/button_events"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/button_selector"
                android:contentDescription="@string/events"
                android:padding="@dimen/tile_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_events"
                app:backgroundTint="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/events"
                android:textColor="@color/black"
                android:textSize="@dimen/tile_label_text_size" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <ImageButton
                android:id="@+id/button_clubs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/button_selector"
                android:contentDescription="@string/clubs"
                android:padding="@dimen/tile_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_clubs"
                app:backgroundTint="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clubs"
                android:textColor="@color/black"
                android:textSize="@dimen/tile_label_text_size" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <ImageButton
                android:id="@+id/button_support"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/button_selector"
                android:contentDescription="@string/support"
                android:padding="@dimen/tile_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_support"
                app:backgroundTint="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/support"
                android:textColor="@color/black"
                android:textSize="@dimen/tile_label_text_size" />
        </LinearLayout>
    </GridLayout>
</LinearLayout>
